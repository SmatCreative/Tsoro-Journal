{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "market-dividends.json",
      "use": "@vercel/static"
    },
    {
      "src": "jse-listings.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "logos/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/indices.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "zse-indices.json"
        ]
      }
    },
    {
      "src": "api/jse.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "jse-listings.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/jse",
      "dest": "/api/jse.js"
    },
    {
      "src": "/api/indices",
      "dest": "/api/indices.js"
    },
    {
      "src": "/tsoro.png",
      "dest": "/tsoro.png"
    },
    {
      "src": "/icon-192.png",
      "dest": "/icon-192.png"
    },
    {
      "src": "/icon-512.png",
      "dest": "/icon-512.png"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/market-dividends.json",
      "dest": "/market-dividends.json"
    },
    {
      "src": "/jse-listings.json",
      "dest": "/jse-listings.json"
    },
    {
      "src": "/logos/(.*)",
      "dest": "/logos/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
